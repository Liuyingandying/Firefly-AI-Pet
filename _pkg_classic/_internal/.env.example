# =============================================================================
# Firefly AI Pet — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# PDF Multimodal Processing
# ---------------------------------------------------------------------------

# DashScope API key for Qwen-VL (free tier available)
# Register: https://dashscope.console.aliyun.com/
# Get key:  https://dashscope.console.aliyuncs.com/apiKey
DASHSCOPE_API_KEY=

# OpenAI-compatible endpoint (DashScope default)
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Qwen-VL model selection
# qwen-vl-plus   — recommended, good quality/speed
# qwen-vl-max    — highest quality, slower
QWEN_VL_MODEL=qwen-vl-plus

# Alternative: OpenAI-compatible vision endpoint
# QWEN_VL_API_KEY=sk-xxxxx
# QWEN_VL_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# PDF Processing Options
# ---------------------------------------------------------------------------

# OCR engine (rapidocr is faster, easyocr is more accurate)
# Install one of: pip install rapidocr_onnxruntime  OR  pip install easyocr
PDF_OCR_ENGINE=rapidocr

# Rendering quality (zoom factor, higher = better OCR but slower)
PDF_RENDER_ZOOM=2.0

# ---------------------------------------------------------------------------
# AI Provider Configuration (existing)
# ---------------------------------------------------------------------------

# Tianjin University Qwen (existing provider)
TJULLM_API_KEY=
TJULLM_BASE_URL=https://ai.tju.edu.cn/api/v3
TJULLM_MODEL=tju-llm

# Zhipu GLM (existing provider)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-plus

# DeepSeek (existing provider)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Claude / Anthropic-compatible (existing workflow provider)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=
